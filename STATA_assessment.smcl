. ***************************
. ***** STATA Assessment ****
. ************** January 2026
. 
. ***********************************
. ** Starting sample: IPUMS CPS (ORG) for 2019
. 
. clear all
{res}{txt}
{com}. cd "E:\RA_01_26\" // replace with local directory here
{res}E:\RA_01_26
{txt}
{com}. use "cps_00006.dta", clear
{txt}
{com}. 
. **********************************************************************
. **# Sample Restrictions (as per Bick, Blandin, and Rogerson (2022))
. **********************************************************************
. keep if age>=25 & age<=64 
{txt}(687,753 observations deleted)

{com}. keep if sex==1 // males only
{txt}(380,603 observations deleted)

{com}. 
. drop if qearnwee==4 // dropping imputed values of weekly earnings
{txt}(24,243 observations deleted)

{com}. keep if quhrsworkorg==0 // dropping imputed values of weekly working hours
{txt}(8 observations deleted)

{com}. keep if qhourwag==0 // dropping imputed values of hourly wages
{txt}(1,617 observations deleted)

{com}. keep if mish==4|mish==8 // keep if observation is in ORG 
{txt}(265,568 observations deleted)

{com}. 
. drop if uhrsworkorg>=998  // don't know or not in universe (usual weekly hours)
{txt}(50,927 observations deleted)

{com}. drop if uhrsworkorg<10 // drop if working less than 10 hours a week at main job
{txt}(103 observations deleted)

{com}. 
. keep if schlcoll==5 // drop if attending school or college
{txt}(2,904 observations deleted)

{com}. drop if classwkr<15 | classwkr>28 // drop if self - employed, Unpaid family worker or Missing/Unknown
{txt}(0 observations deleted)

{com}. 
. drop if hourwage  <4 // subminwage variable is not available, 
{txt}(33 observations deleted)

{com}. // so we drop half of 7.5 <- average federal minimum hourly wage
. drop if hourwage==999.99 // drop if not in universe
{txt}(0 observations deleted)

{com}. drop if earnweek==9999.99 // not in universe
{txt}(0 observations deleted)

{com}. drop if union==0 // drop if not in universe
{txt}(0 observations deleted)

{com}. drop if ind1950 == 0 | ind1950 == 997 | ind1950 == 998 //drop if not in universe
{txt}(0 observations deleted)

{com}. 
. 
. ****************************************
. **# New Categorical Variables defined
. ****************************************
. 
. gen age_2 = age*age
{txt}
{com}. label var age_2 "Age square"
{txt}
{com}. 
. gen metro_bin = .
{txt}(10,304 missing values generated)

{com}. replace metro_bin = 1 if inlist(metro, 2, 3)
{txt}(5,881 real changes made)

{com}. replace metro_bin = 0 if metro == 1
{txt}(2,256 real changes made)

{com}. label define metro_bin_lbl ///
>     0 "Non-metropolitan" ///
>     1 "Metropolitan", replace
{txt}
{com}. label values metro_bin metro_bin_lbl
{txt}
{com}. label variable metro_bin "Metropolitan residence (binary)"
{txt}
{com}. 
. 
. gen race_cats = 0 // non-black, non-Hispanic
{txt}
{com}. replace race_cats=1 if race==200 // black
{txt}(883 real changes made)

{com}. replace race_cats=2 if race==300 // hispanic
{txt}(166 real changes made)

{com}. label define race_cats 0 "Base" 1 "Black" 2 "Hispanic"
{txt}
{com}. label values race_cats race_cats
{txt}
{com}. label variable race_cats "Race categories"
{txt}
{com}. 
. gen marital_status=0
{txt}
{com}. replace marital_status=1 if marst>2 // non-married
{txt}(4,842 real changes made)

{com}. drop if marst==9 // not in universe
{txt}(0 observations deleted)

{com}. label define marital_status 0 "Married" 1 "Non-married"
{txt}
{com}. label values marital_status marital_status
{txt}
{com}. label var marital_status "Marital Status"
{txt}
{com}. 
. **************************************************
. * Broad industry category from ind1950
. *_________________________________________________
. gen ind1950_broad = floor(ind1950/100)
{txt}
{com}. 
. * NIU / not reported
. replace ind1950_broad = 0 if ind1950 == 0 | ind1950 == 997 | ind1950 == 998
{txt}(0 real changes made)

{com}. 
. label define ind1950_broad_lbl ///
>     0 "NIU / Not reported / Nonclassifiable" ///
>     1 "Agriculture, Forestry, and Fishing" ///
>     2 "Mining" ///
>     3 "Manufacturing-Durables" ///
>     4 "Manufacturing-Nondurables" ///
>     5 "Transportation, Communication, and Other Utilities" ///
>     6 "Wholesale and Retail Trade" ///
>     7 "Finance, Insurance, and Real Estate" ///
>     8 "Services" ///
>     9 "Public Administration"
{txt}
{com}. 
. label values ind1950_broad ind1950_broad_lbl
{txt}
{com}. label variable ind1950_broad "Industry, broad category (IND1950 first digit)"
{txt}
{com}. *************************************************
. gen sector=.
{txt}(10,304 missing values generated)

{com}. replace sector=0 if classwkr>14 & classwkr<24
{txt}(9,311 real changes made)

{com}. replace sector=1 if classwkr>23 & classwkr<29
{txt}(993 real changes made)

{com}. label define sector 0 "Private" 1"Public"
{txt}
{com}. label values sector sector
{txt}
{com}. label var sector "Sector"
{txt}
{com}. 
. gen union_cov =0
{txt}
{com}. replace union_cov=1 if union >1
{txt}(1,574 real changes made)

{com}. label define union_cov 0 "Not union covered" 1 "Union covered"
{txt}
{com}. label values union_cov union_cov
{txt}
{com}. label var union_cov "Covered by union"
{txt}
{com}. 
. gen educ_cat=.
{txt}(10,304 missing values generated)

{com}. replace educ_cat=1 if educ<=72
{txt}(1,240 real changes made)

{com}. replace educ_cat=2 if educ>=73 & educ<111
{txt}(7,390 real changes made)

{com}. replace educ_cat=3 if educ>=111 & educ<=122
{txt}(1,393 real changes made)

{com}. replace educ_cat=4 if educ>122
{txt}(281 real changes made)

{com}. label define educ_cat 1 "LHS" 2 "HS" 3 "Bach" 4 "Bach+"
{txt}
{com}. label values educ_cat educ_cat
{txt}
{com}. label var educ_cat "Education categories"
{txt}
{com}. 
. ***********************************************
. ** Generate usual weekly working hour bins
. *______________________________________________
. * Create hour bins: 10–65 in 5-hour bins, top-code at 70+
. gen hour_bin = .
{txt}(10,304 missing values generated)

{com}. 
. replace hour_bin = floor((uhrswork1 - 10)/5) ///
>     if inrange(uhrswork1, 10, 69)
{txt}(9,760 real changes made)

{com}. 
. replace hour_bin = 12 if inrange(uhrswork1, 70, 99)
{txt}(97 real changes made)

{com}. 
. * Define value labels
. label define hour_bin 0 "10" 1 "15" 2 "20" 3 "25" 4 "30" 5 "35" 6 "40" 7 "45" 8 "50" 9 "55" 10 "60" 11 "65" 12 "70+"
{txt}
{com}. 
. 
. label values hour_bin hour_bin
{txt}
{com}. label var hour_bin "Hours bin (usual weekly hours)"
{txt}
{com}. **************************************************************************
. 
. ***********************************
. **# Dependent Variables
. ***********************************
. gen ln_hourwage = ln(hourwage)
{txt}
{com}. label var ln_hourwage "Log of Hourly wage"
{txt}
{com}. 
. gen ln_hourwage2 = ln(earnweek/uhrsworkorg)
{txt}
{com}. 
. corr ln_hourwage ln_hourwage2 // 93% correlation
{txt}(obs=10,304)

             {c |} ln_hou~e ln_hou~2
{hline 13}{c +}{hline 18}
 ln_hourwage {c |}{res}   1.0000
{txt}ln_hourwage2 {c |}{res}   0.9319   1.0000

{txt}
{com}. 
. gen ln_earnweek = ln(earnweek_cpiu_2010)
{txt}
{com}. label var ln_earnweek "Log of Weekly Earnings"
{txt}
{com}. ***********************************
